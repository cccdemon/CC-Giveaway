{
    admin off
    email admin@{$DOMAIN}
}

{$DOMAIN} {

    # ── Giveaway Service ──────────────────────────────────
    # REST + WebSocket (/giveaway/ws)
    handle /giveaway/* {
        uri strip_prefix /giveaway
        reverse_proxy giveaway:3001
    }

    # ── Admin Dashboard ───────────────────────────────────
    # Login + user management + aggregated health
    handle /admin/* {
        uri strip_prefix /admin
        reverse_proxy admin:3005
    }

    # ── Bridge health (internal use only) ─────────────────
    handle /bridge/* {
        uri strip_prefix /bridge
        reverse_proxy bridge:3000
    }

    # ── Crawler ───────────────────────────────────────────
    handle /sitemap.xml {
        reverse_proxy admin:3005
    }
    handle /robots.txt {
        reverse_proxy admin:3005
    }

    # ── Liveness (offen) + Aggregat (nur superadmin, App-seitig) ──
    handle /healthz {
        reverse_proxy admin:3005
    }
    handle /health {
        reverse_proxy admin:3005
    }

    # ── Redis UI ──────────────────────────────────────────
    handle /redis-ui/* {
        uri strip_prefix /redis-ui
        reverse_proxy redis-ui:8081
    }

    # ── Root redirect → admin dashboard ──────────────────
    # 302 so the browser actually navigates to /admin/ — otherwise
    # relative asset paths (pub-doc.css etc.) resolve to /
    # which has no handler and the page renders unstyled.
    @root path /
    redir @root /admin/ 302

    header {
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000"
        Cache-Control "no-cache, must-revalidate"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net; connect-src 'self' wss:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        -Server
    }

    # Keine Zugriffsprotokollierung: Requests enthalten IP-Adressen, und die
    # Docker-Logrotation ist groessenbasiert - eine Speicherfrist liesse sich
    # damit nicht zusagen. Nur Fehler werden geloggt.
    log {
        output stdout
        format console
        level ERROR
    }
}
