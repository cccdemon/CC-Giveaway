{
    admin off
    # Edge (LXC 101 nginx) does L4 SNI-passthrough; TLS terminates HERE.
    # No inbound :80 → Cloudflare DNS-01 (needs CF_API_TOKEN + the
    # caddy-dns/cloudflare plugin baked into Dockerfile.team).
    auto_https disable_redirects
    acme_dns cloudflare {env.CF_API_TOKEN}
}

{$DOMAIN} {

    # Kein CORS-Freibrief mehr (ChatGPT-Review #10): die Anwendung ist
    # same-origin; Access-Control-Allow-Origin * war unnötig breit.
    # CSP: Inline-Skripte/-Styles sind im Bestand nötig ('unsafe-inline'),
    # externe Skript-Quellen bleiben trotzdem blockiert. Twitch-Avatare
    # kommen von static-cdn.jtvnw.net.
    header {
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000"
        Cache-Control "no-cache, must-revalidate"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://static-cdn.jtvnw.net; connect-src 'self' wss:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        -Server
    }

    route {
        # ── Auth gate (central forward_auth → admin) ──────────
        # Everything except the login page, auth endpoints and health
        # requires a valid session cookie. On failure admin returns
        # 302 → /admin/login.html.
        # /admin/og-preview.png muss offen bleiben: Link-Vorschau-Crawler
        # (Discord, WhatsApp, X) haben keine Session und wuerden sonst 302 bekommen.
        @needsauth not path / /admin/home.html /admin/login.html /admin/join.html /admin/setup.html /admin/impressum.html /admin/datenschutz.html /admin/nutzungsbedingungen.html /admin/haftungsausschluss.html /admin/roadmap.html /admin/changelog.html /admin/funktionsweise.html /admin/pub-doc.js /admin/pub-doc.css /admin/og-preview.png /admin/auth/* /admin/pub/* /viewer/* /healthz /sitemap.xml /robots.txt /ingest* /giveaway/overlay-ws /giveaway/giveaway-overlay* /giveaway/giveaway-join*
        # method GET ist PFLICHT: ohne das schickt Caddy Methode UND Body der
        # Originalanfrage an /auth/verify. Der Body ist danach verbraucht und
        # kommt beim eigentlichen Dienst leer an — jedes POST hinter dem Gate
        # sieht dann ein leeres req.body (das war die Ursache von
        # "version_mismatch" beim Zustimmen zu den Nutzungsbedingungen).
        forward_auth @needsauth admin:3005 {
            uri /auth/verify
            method GET
            copy_headers X-Auth-User X-Auth-Role
        }

        # ── Superadmin-Gate ───────────────────────────────────
        # Infrastruktur-Werkzeuge: Redis Commander schreibt direkt in den
        # Live-State, /health nennt interne Servicenamen und Fehlertexte.
        # Beides nur fuer Plattform-Administratoren. Laeuft NACH dem
        # allgemeinen Gate, prueft also nur noch die Rolle.
        @superadmin path /health /redis-ui /redis-ui/*
        forward_auth @superadmin admin:3005 {
            uri /auth/verify-superadmin
            method GET
            copy_headers X-Auth-User X-Auth-Role
        }

        # ── Giveaway Service (REST + WS /giveaway/ws) ─────────
        handle /giveaway/* {
            uri strip_prefix /giveaway
            reverse_proxy giveaway:3001
        }

        # ── Viewer (public: status, terms, help) ─────────────
        handle /viewer/status {
            rewrite * /status.html
            reverse_proxy admin:3005
        }
        handle /viewer/terms {
            rewrite * /terms.html
            reverse_proxy admin:3005
        }
        handle /viewer/help {
            rewrite * /help.html
            reverse_proxy admin:3005
        }
        # Kurzlinks aus dem Chat → Zuschauer-Seiten (Ziel liegt hinter Login).
        # Die Gewinner-Ansage verlinkt /viewer/claim — ohne diese Redirects
        # führte der Link ins Leere (404).
        handle /viewer/claim {
            redir * /giveaway/claim.html 302
        }
        handle /viewer/wager {
            redir * /giveaway/wager.html 302
        }
        handle /viewer/contest {
            redir * /giveaway/contest.html 302
        }

        # ── Admin (login, user management, health, pages) ─────
        handle /admin/* {
            uri strip_prefix /admin
            reverse_proxy admin:3005
        }

        # ── Bridge health (internal use only) ─────────────────
        handle /bridge/* {
            uri strip_prefix /bridge
            reverse_proxy bridge:3000
        }

        # ── Ingest WS (Phase 3: Streamerbots connect IN) ──────
        handle /ingest* {
            uri strip_prefix /ingest
            reverse_proxy bridge:3000
        }

        # ── Crawler (public) ──────────────────────────────────
        handle /sitemap.xml {
            reverse_proxy admin:3005
        }
        handle /robots.txt {
            reverse_proxy admin:3005
        }

        # ── Liveness (public) + Aggregat (superadmin, s. Gate oben) ──
        handle /healthz {
            reverse_proxy admin:3005
        }
        handle /health {
            reverse_proxy admin:3005
        }

        # ── Redis UI ──────────────────────────────────────────
        handle /redis-ui/* {
            uri strip_prefix /redis-ui
            reverse_proxy redis-ui:8081
        }

        # ── Root → public landing page (served in place at /) ─
        handle / {
            rewrite * /home.html
            reverse_proxy admin:3005
        }
    }

    # Keine Zugriffsprotokollierung: Requests enthalten IP-Adressen, und die
    # Docker-Logrotation ist groessenbasiert - eine Speicherfrist liesse sich
    # damit nicht zusagen. Nur Fehler werden geloggt.
    log {
        output stdout
        format console
        level ERROR
    }
}
