# ════════════════════════════════════════════════════════
# Team-Giveaway (team.raumdock.org) – Environment  (LXC 103)
# Copy to .env on the server. Secrets NOT committed.
# ════════════════════════════════════════════════════════

# Public domain (drives Caddyfile.team {$DOMAIN} + cert)
DOMAIN=team.raumdock.org

# Team stack uses the TLS/DNS-01 Caddyfile
CADDY_CONFIG=Caddyfile.team

# Cloudflare API token for DNS-01 ACME — copied from /opt/RDOC-Suite/.env
CF_API_TOKEN=

# PostgreSQL (own volume, isolated from RDOC-Suite)
PG_DB=chaoscrew
PG_USER=chaoscrew
PG_PASSWORD=

# Redis UI (loopback only)
REDIS_UI_USER=chaos
REDIS_UI_PASSWORD=

# ── Login / Benutzerverwaltung (admin service) ──
# Stable secret for signed session cookies (openssl rand -hex 32).
# If unset, sessions drop on every admin restart.
SESSION_SECRET=
# Bootstrap superadmin (created only when the admin_users table is empty).
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=
# Twitch-Logins mit Plattform-Adminrechten (Superadmin): Redis Commander,
# /health, Benutzerverwaltung. Komma-getrennt, wird bei jedem Start gesetzt.
PLATFORM_ADMINS=justcallmedeimos
# Cookies require HTTPS in prod; set false only for local HTTP dev.
COOKIE_SECURE=true
# Basis-URL fuer Login-Redirects und Mail-/Chat-Links des admin-Service.
ADMIN_PUBLIC_URL=https://team.raumdock.org

# ── Twitch-OAuth (admin + giveaway) ──
# PFLICHT. Ohne diese beiden kommt niemand am Login vorbei, weil die gesamte
# Auth ueber Twitch-OAuth laeuft. App anlegen unter dev.twitch.tv/console/apps,
# Redirect-URL: https://team.raumdock.org/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── giveaway-Service ──
# Shared-Secret admin<->giveaway fuer /internal/team/cleanup und
# /internal/ingest-pulse. Erzeugen z.B. mit: openssl rand -hex 24.
# Leer = beide Endpunkte tot: Team-Loeschung laesst den Live-State in Redis
# stehen, und die Seite "Betrieb & Diagnose" zeigt keinen Ingest-Puls.
INTERNAL_API_KEY=
# Test-Console-Simulation (viewer_tick/chat_msg). Erzeugt ECHTE Viewtime in
# watchtime_events und geht in Ziehungs-Snapshots ein. In prod: aus lassen.
ALLOW_SIM=false

# Zeitgeber des giveaway-Service (Ticker, Sofort-Fenster-Watcher, Retention).
# Genau EINE Instanz darf sie fahren. Bei einem Container immer true; erst bei
# Replikation auf allen weiteren Instanzen false (docs/SKALIERUNG.md).
RUN_SCHEDULER=true
# Hinweis: MAX_PARALLEL_GIVEAWAYS (Default 4) und PUBLIC_URL
# (Default https://team.raumdock.org) liest der giveaway-Service zwar, sie
# stehen aber bewusst nicht in docker-compose.yml. Hier eintragen bringt also
# nichts, solange dort kein environment-Eintrag ergaenzt wird.

# ── Rueckmeldungen ──
# Discord-Webhook fuer "Fehler melden & Idee schicken".
# Leer = Meldungen landen nur in der Tabelle feedback, ohne Benachrichtigung.
DISCORD_FEEDBACK_WEBHOOK=

# Streamerbot ingest — Phase 1 inverts this (bots connect IN). For the
# initial pipeline smoke-test the old outbound bridge target is unused/unreachable.
SB_HOST=127.0.0.1
SB_PORT=9090
